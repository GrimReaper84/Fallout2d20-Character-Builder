<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.CheckMenuItem?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.input.KeyCodeCombination?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
  fx:controller="de.fallout2d20.charbuilder.view.MainWindowController">
  <top>
    <MenuBar fx:id="menuBar">
      <Menu text="File">
        <MenuItem text="New" onAction="#onNew">
          <accelerator><KeyCodeCombination code="N" control="DOWN" shift="UP" alt="UP" meta="UP" shortcut="UP"/></accelerator>
        </MenuItem>
        <MenuItem text="Open…" onAction="#onOpen">
          <accelerator><KeyCodeCombination code="O" control="DOWN" shift="UP" alt="UP" meta="UP" shortcut="UP"/></accelerator>
        </MenuItem>
        <MenuItem text="Save" onAction="#onSave">
          <accelerator><KeyCodeCombination code="S" control="DOWN" shift="UP" alt="UP" meta="UP" shortcut="UP"/></accelerator>
        </MenuItem>
        <MenuItem text="Save As…" onAction="#onSaveAs">
          <accelerator><KeyCodeCombination code="S" control="DOWN" shift="DOWN" alt="UP" meta="UP" shortcut="UP"/></accelerator>
        </MenuItem>
        <SeparatorMenuItem/>
        <MenuItem fx:id="exportSheetItem" text="Export Character Sheet (PDF)…" onAction="#onExportSheet" disable="true">
          <accelerator><KeyCodeCombination code="P" control="DOWN" shift="UP" alt="UP" meta="UP" shortcut="UP"/></accelerator>
        </MenuItem>
        <SeparatorMenuItem/>
        <MenuItem text="Exit" onAction="#onExit"/>
      </Menu>
      <Menu text="Character">
        <MenuItem fx:id="createCharacterItem" text="Create Character" onAction="#onCreateCharacter" disable="true"/>
        <SeparatorMenuItem/>
        <CheckMenuItem fx:id="gmModeItem" text="GM mode" onAction="#onGmMode" disable="true"/>
      </Menu>
      <Menu text="Help">
        <MenuItem text="About" onAction="#onAbout"/>
      </Menu>
    </MenuBar>
  </top>
  <center>
    <StackPane fx:id="contentPane"/>
  </center>
</BorderPane>
